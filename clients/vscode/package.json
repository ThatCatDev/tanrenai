{
  "name": "tanrenai",
  "displayName": "Tanrenai",
  "description": "Agentic coding assistant — runs the Tanrenai agent inside VS Code",
  "version": "0.1.0",
  "publisher": "ThatCatDev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:tanrenai.chat"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tanrenai",
          "title": "Tanrenai",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "tanrenai": [
        {
          "type": "webview",
          "id": "tanrenai.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "tanrenai.login",
        "title": "Tanrenai: Login"
      },
      {
        "command": "tanrenai.logout",
        "title": "Tanrenai: Logout"
      },
      {
        "command": "tanrenai.reconnect",
        "title": "Tanrenai: Reconnect"
      },
      {
        "command": "tanrenai.pickModel",
        "title": "Tanrenai: Choose Model…"
      },
      {
        "command": "tanrenai.addSelection",
        "title": "Tanrenai: Add Selection to Chat"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "tanrenai.addSelection",
          "when": "editorHasSelection",
          "group": "tanrenai"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tanrenai.addSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "Tanrenai",
      "properties": {
        "tanrenai.serverUrl": {
          "type": "string",
          "default": "",
          "description": "Backend server URL. Empty = use the URL from credentials.json."
        },
        "tanrenai.model": {
          "type": "string",
          "default": "Qwen3.6-35B-A3B-UD-Q4_K_M",
          "description": "Default model to load when starting a session."
        },
        "tanrenai.mode": {
          "type": "string",
          "enum": [
            "chat",
            "agent",
            "swarm"
          ],
          "default": "agent",
          "description": "Default mode: chat (no tools), agent (single agent with tools), swarm (multi-agent orchestrator)."
        },
        "tanrenai.agentMode": {
          "type": "boolean",
          "default": true,
          "description": "Legacy: enable agent mode. Use `tanrenai.mode` instead."
        },
        "tanrenai.cliPath": {
          "type": "string",
          "default": "",
          "description": "Override path to the tanrenai CLI binary. Empty = use the bundled binary or `tanrenai` from PATH."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "vsce package",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "webview:dev": "node scripts/serve-dev.mjs"
  },
  "dependencies": {
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "esbuild": "^0.20.0",
    "happy-dom": "^20.9.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
